{
  "name": "ragnarok-reborn-npcs",
  "version": "1.0.0",
  "private": true,
  "description": "Build and verify scripts for the Foundry VTT compendium packs.",
  "type": "module",
  "scripts": {
    "pack": "node build-pack.mjs",
    "build": "node build-pack.mjs",
    "verify": "node verify-packs.mjs",
    "check:maps": "node check-scene-maps.mjs",
    "check:fresh": "node check-fresh.mjs",
    "check:fresh:snapshot": "node check-fresh.mjs snapshot",
    "sync:npcs": "python3 tools/sync-npc-sources.py",
    "sync:npcs:check": "python3 tools/sync-npc-sources.py --check",
    "verify:snapshot": "python3 tools/check-actor-fixes.py --snapshot",
    "verify:snapshot:check": "python3 tools/check-actor-fixes.py --check",
    "check": "python3 tools/check_all.py",
    "check:docs": "python3 tools/check-documented-data.py",
    "check:arch": "python3 tools/check-architecture-doc.py"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4"
  }
}
